<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Restaurante Elegance — Alta gastronomía en Balmaseda, Bizkaia. Reserva tu mesa ahora.">
    <title>@ViewData["Title"] - Restaurante</title>
    
    <!-- Tailwind CSS (CDN para desarrollo) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: '#C5A880', secondary: '#F9F6F0', dark: '#1A1A1A' },
                    fontFamily: { sans: ['Lexend', 'sans-serif'], serif: ['Lexend', 'sans-serif'] }
                }
            }
        }
    </script>
    
    <style>
        body { font-family: 'Lexend', sans-serif; }
        .fade-in-up { animation: fadeInUp 0.8s ease-out forwards; opacity: 0; }
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-secondary text-dark mx-auto max-w-[1400px] shadow-2xl min-h-screen flex flex-col">

    <!-- Header (Migrado de _Header.js) -->
    <header class="flex justify-between items-center px-6 md:px-10 py-4 bg-white/40 backdrop-blur-2xl backdrop-saturate-[1.8] sticky top-0 z-50 shrink-0 border-b border-white/50 shadow-sm">
        <!-- Logo -->
        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 hover:opacity-80 transition z-50">
            <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" fill="currentColor"/>
            </svg>
            <span class="font-serif font-bold text-xl tracking-[0.2em] uppercase text-dark">Restaurante</span>
        </a>

        <!-- Navegación Desktop -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-semibold uppercase tracking-widest text-dark">
            <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "text-primary" : "hover:text-primary") transition-colors hover:-translate-y-0.5 transform duration-300">Inicio</a>
            <a asp-controller="Menu" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "text-primary" : "hover:text-primary") transition-colors hover:-translate-y-0.5 transform duration-300">Menú</a>
            <a asp-controller="QuienesSomos" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "QuienesSomos" ? "text-primary" : "hover:text-primary") transition-colors hover:-translate-y-0.5 transform duration-300">Sobre Nosotros</a>
            <a asp-controller="Contacto" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacto" ? "text-primary" : "hover:text-primary") transition-colors hover:-translate-y-0.5 transform duration-300">Contáctanos</a>
            <a asp-controller="Reservas" asp-action="Index" class="bg-dark text-white px-6 py-3 rounded-full hover:bg-primary transition-colors duration-300">Haz Reserva</a>
        </nav>

        <!-- Botón Menú Hamburguesa Mobile -->
        <button id="header-menu-btn" class="md:hidden flex flex-col gap-1.5 z-50 p-2 group" aria-label="Abrir menú">
            <span class="block w-6 h-0.5 bg-dark transition-transform duration-300 origin-center group-hover:bg-primary" id="h-line1"></span>
            <span class="block w-6 h-0.5 bg-dark transition-opacity duration-300 group-hover:bg-primary" id="h-line2"></span>
            <span class="block w-6 h-0.5 bg-dark transition-transform duration-300 origin-center group-hover:bg-primary" id="h-line3"></span>
        </button>
    </header>

    <!-- Overlay Menú Mobile -->
    <div id="header-mobile-menu" class="fixed inset-0 bg-secondary/80 backdrop-blur-2xl backdrop-saturate-[1.8] flex-col justify-start pt-32 items-center gap-8 text-base font-serif uppercase tracking-widest hidden opacity-0 transition-opacity duration-300 z-40">
        <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "text-primary" : "hover:text-primary") transition-colors">Inicio</a>
        <a asp-controller="Menu" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "text-primary" : "hover:text-primary") transition-colors">Menú</a>
        <a asp-controller="QuienesSomos" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "QuienesSomos" ? "text-primary" : "hover:text-primary") transition-colors">Sobre Nosotros</a>
        <a asp-controller="Contacto" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacto" ? "text-primary" : "hover:text-primary") transition-colors">Contáctanos</a>
        <a asp-controller="Reservas" asp-action="Index" class="bg-primary text-white font-sans text-sm font-bold tracking-widest px-8 py-4 rounded-full hover:bg-dark transition-colors mt-4">Haz Reserva</a>
    </div>

    <!-- MAIN CONTENT -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer (Migrado de _Footer.js) -->
    <footer class="bg-dark text-secondary py-16 px-6 md:px-16 lg:px-24 shrink-0 transition-colors duration-500">
        <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
            <!-- Columna 1 -->
            <div class="flex flex-col gap-4">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 hover:opacity-80 transition">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" fill="currentColor"/>
                    </svg>
                    <h4 class="font-serif text-2xl font-bold tracking-widest uppercase text-primary">Restaurante</h4>
                </a>
                <p class="text-sm font-light text-gray-400 leading-[1.8] max-w-xs mt-2">
                    Una experiencia gastronómica inolvidable donde la alta cocina se encuentra con la elegancia y la tradición.
                </p>
                <div class="flex gap-4 mt-4">
                    <!-- Iconos sociales dummy -->
                    <svg class="w-5 h-5 text-gray-400 hover:text-primary cursor-pointer transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <svg class="w-5 h-5 text-gray-400 hover:text-primary cursor-pointer transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <svg class="w-5 h-5 text-gray-400 hover:text-primary cursor-pointer transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>
            </div>

            <!-- Columna 2 -->
            <div class="flex flex-col gap-6">
                <h4 class="font-serif text-lg font-bold tracking-widest uppercase text-white">Contacto</h4>
                <ul class="text-sm font-light text-gray-400 flex flex-col gap-3">
                    <li class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                        Balmaseda, Bizkaia
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        +34 900 123 456
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        reservas@restaurante.com
                    </li>
                </ul>
            </div>

            <!-- Columna 3 (Horarios Estáticos) -->
            <div class="flex flex-col gap-6">
                <h4 class="font-serif text-lg font-bold tracking-widest uppercase text-white">Horarios</h4>
                <ul class="text-sm font-light text-gray-400 flex flex-col gap-3">
                    <li class="flex justify-between border-b border-gray-800/50 pb-2"><span>Lunes</span><span class="text-secondary">Cerrado</span></li>
                    <li class="flex justify-between border-b border-gray-800/50 pb-2"><span>Martes - Jueves</span><span class="text-secondary">13:00 - 16:00, 20:00 - 23:00</span></li>
                    <li class="flex justify-between border-b border-gray-800/50 pb-2"><span>Viernes</span><span class="text-secondary">13:00 - 16:00, 20:00 - 00:00</span></li>
                    <li class="flex justify-between border-b border-gray-800/50 pb-2"><span>Sábado</span><span class="text-secondary">13:00 - 00:00</span></li>
                    <li class="flex justify-between text-primary mt-1"><span>Domingo</span><span>13:00 - 17:00</span></li>
                </ul>
            </div>
        </div>
        <div class="max-w-[1200px] mx-auto mt-16 pt-8 border-t border-gray-800 text-center text-xs text-gray-500 font-light tracking-widest uppercase">
            &copy; 2026 Restaurante Elegance. Todos los derechos reservados.
        </div>
    </footer>

    <!-- Lógica base para Menú Mobile -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const menuBtn    = document.getElementById('header-menu-btn');
            const mobileMenu = document.getElementById('header-mobile-menu');
            const line1      = document.getElementById('h-line1');
            const line2      = document.getElementById('h-line2');
            const line3      = document.getElementById('h-line3');
            let isMenuOpen = false;

            if(menuBtn) {
                menuBtn.addEventListener('click', () => {
                    isMenuOpen = !isMenuOpen;
                    if (isMenuOpen) {
                        mobileMenu.classList.remove('hidden');
                        mobileMenu.classList.add('flex');
                        setTimeout(() => mobileMenu.classList.remove('opacity-0'), 10);
                        line1.classList.add('translate-y-2', 'rotate-45');
                        line2.classList.add('opacity-0');
                        line3.classList.add('-translate-y-2', '-rotate-45');
                        document.body.style.overflow = 'hidden';
                    } else {
                        mobileMenu.classList.add('opacity-0');
                        setTimeout(() => {
                            mobileMenu.classList.add('hidden');
                            mobileMenu.classList.remove('flex');
                        }, 300);
                        line1.classList.remove('translate-y-2', 'rotate-45');
                        line2.classList.remove('opacity-0');
                        line3.classList.remove('-translate-y-2', '-rotate-45');
                        document.body.style.overflow = '';
                    }
                });
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
