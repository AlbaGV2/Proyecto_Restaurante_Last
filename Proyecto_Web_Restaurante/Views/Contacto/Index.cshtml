@{
    ViewData["Title"] = "Contacto";
}

<!-- Hero -->
        <div class="w-full h-[50vh] md:h-[65vh] relative animate-on-scroll">
            <img src="https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Detalle restaurante" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/60"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4 animate-on-scroll" data-delay="0.2s">
                <h1 class="font-serif text-3xl md:text-4xl text-white font-bold tracking-wider mb-6">Contacto</h1>
                <div class="w-16 h-0.5 bg-primary mx-auto mb-6"></div>
                <p class="text-white/80 font-light tracking-widest uppercase text-sm">A su entera disposición</p>
            </div>
        </div>

        <!-- Formulario -->
        <div class="px-4 md:px-10 py-24 flex justify-center bg-white animate-on-scroll">
            <div class="bg-secondary rounded-[40px] px-6 md:px-20 py-16 md:py-24 max-w-3xl w-full shadow-lg border border-[#eaddce]/50">
                <div class="text-center mb-16">
                    <h2 class="font-serif text-2xl md:text-3xl font-bold text-dark mb-4">Escríbenos</h2>
                    <p class="text-gray-500 font-light text-sm md:text-[15px] leading-relaxed">Estaremos encantados de ayudarle a planificar su evento especial o resolver cualquier duda sobre nuestra propuesta gastronómica.</p>
                </div>
                <form action="https://formsubmit.co/mikelvalmasedagarcia@iesbalmasedabhi.com" method="POST" class="flex flex-col gap-10">
                    <div class="relative group">
                        <input type="text" name="name" id="name" required placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-3 text-base transition-colors duration-300 peer font-serif" />
                        <label for="name" class="absolute left-0 top-3 text-gray-400 text-base transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-7 peer-focus:text-primary peer-focus:text-xs peer-placeholder-shown:translate-y-0 peer-not-placeholder-shown:-translate-y-7 peer-not-placeholder-shown:text-xs">Nombre Completo</label>
                    </div>
                    <div class="relative group">
                        <input type="email" name="email" id="email" required placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-3 text-base transition-colors duration-300 peer font-serif" />
                        <label for="email" class="absolute left-0 top-3 text-gray-400 text-base transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-7 peer-focus:text-primary peer-focus:text-xs peer-placeholder-shown:translate-y-0 peer-not-placeholder-shown:-translate-y-7 peer-not-placeholder-shown:text-xs">Correo Electrónico</label>
                    </div>
                    <div class="relative group">
                        <textarea name="message" id="message" rows="4" required placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-3 text-base transition-colors duration-300 peer font-serif resize-none"></textarea>
                        <label for="message" class="absolute left-0 top-3 text-gray-400 text-base transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-7 peer-focus:text-primary peer-focus:text-xs peer-placeholder-shown:translate-y-0 peer-not-placeholder-shown:-translate-y-7 peer-not-placeholder-shown:text-xs">Su Mensaje</label>
                    </div>
                    <div class="flex justify-center mt-6">
                        <button type="submit" class="bg-dark text-white px-16 py-4 w-full md:w-auto rounded-full text-xs font-bold tracking-[0.2em] uppercase hover:bg-primary hover:-translate-y-1 transform transition-all shadow-lg duration-300">
                            Enviar Mensaje
                        </button>
                    </div>
                </form>
            </div>
        </div>
@section Scripts {
    <script type="module" src="~/js/controllers/ContactoController.js"></script>
}
