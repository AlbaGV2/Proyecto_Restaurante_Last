@{
    ViewData["Title"] = "Quiénes Somos";
}

<!-- Hero -->
        <div class="w-full h-[60vh] md:h-[75vh] relative animate-on-scroll">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Interior del Restaurante Lujoso" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/50"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4 animate-on-scroll" data-delay="0.2s">
                <h1 class="font-serif text-3xl md:text-4xl text-white font-bold tracking-wider mb-6">Quiénes Somos</h1>
                <div class="w-16 h-0.5 bg-primary mx-auto"></div>
            </div>
        </div>

        <!-- Contenido -->
        <div class="px-4 md:px-10 py-24 flex justify-center bg-white animate-on-scroll">
            <div class="bg-secondary rounded-[40px] px-4 md:px-16 py-16 md:py-24 max-w-4xl w-full shadow-sm border border-[#eaddce]/50">
                <p class="text-gray-800 font-light text-sm md:text-[15px] leading-[2] max-w-2xl mx-auto text-center">
                    Nuestro restaurante ofrece una experience gastronómica única, combinando ingredientes de alta calidad con una presentación cuidada y un ambiente elegante. Nuestro objetivo es que cada cliente disfrute de una comida especial y un servicio excepcional, inspirado en las recetas tradicionales pero con un toque vanguardista.
                    <br><br>
                    Contamos con un equipo de profesionales apasionados por la cocina y la atención al cliente. Desde nuestros Chefs hasta el sumiller y el personal de sala, todos trabajamos juntos para crear una experiencia verdaderamente inolvidable para todos los que nos visitan.
                </p>
                <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-12 max-w-2xl mx-auto">
                    <!-- Chef 1: Mikel Valmaseda -->
                    <div class="text-center flex flex-col items-center">
                        <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&h=400&q=80" alt="Chef Mikel Valmaseda" class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-full mx-auto border-4 border-white shadow-lg opacity-90 transition-transform duration-300 hover:scale-105 text-center flex items-center justify-center"/>
                        <h3 class="font-serif text-lg font-bold mt-6 text-dark tracking-widest">Mikel Valmaseda</h3>
                        <p class="text-primary text-sm font-light tracking-widest uppercase mt-1">Chef</p>
                    </div>

                    <!-- Chef 2: Alba Garcia -->
                    <div class="text-center flex flex-col items-center">
                        <img src="https://images.unsplash.com/photo-1581299894007-aaa50297cf16?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&h=400&q=80" alt="Chef Alba Garcia" class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-full mx-auto border-4 border-white shadow-lg opacity-90 transition-transform duration-300 hover:scale-105 text-center flex items-center justify-center"/>
                        <h3 class="font-serif text-lg font-bold mt-6 text-dark tracking-widest">Alba Garcia</h3>
                        <p class="text-primary text-sm font-light tracking-widest uppercase mt-1">Chef</p>
                    </div>
                </div>
            </div>
        </div>
@section Scripts {
    <script type="module" src="~/js/controllers/QuienesSomosController.js"></script>
}
