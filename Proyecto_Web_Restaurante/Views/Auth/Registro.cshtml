@{
    ViewData["Title"] = "Registro";
}

<!-- Imagen lateral -->
        <div class="w-full md:w-1/2 h-[40vh] md:h-auto relative animate-on-scroll border-r border-[#eaddce]/30">
            <img src="https://images.unsplash.com/photo-1544148103-0773bf10d330?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Detalle restaurante" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/50"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-8 z-10 animate-on-scroll" data-delay="0.2s">
                <h1 class="font-serif text-3xl md:text-5xl text-white font-bold tracking-wider mb-6">Únete</h1>
                <div class="w-16 h-0.5 bg-primary mx-auto mb-6"></div>
                <p class="text-white/90 font-light tracking-widest uppercase text-xs md:text-sm">Regístrate para vivir la experiencia</p>
            </div>
        </div>

        <!-- Formulario Registro -->
        <div class="w-full md:w-1/2 flex items-center justify-center p-8 md:p-16 bg-white shrink-0 relative overflow-hidden">
            <div class="absolute -top-[20%] -right-[20%] w-[60%] h-[60%] bg-secondary rounded-full blur-3xl opacity-50 pointer-events-none"></div>

            <div class="w-full max-w-sm animate-on-scroll relative z-10" data-delay="0.3s">
                <div class="mb-10">
                    <h2 class="font-serif text-3xl font-bold text-dark mb-4">Registro</h2>
                    <p class="text-gray-500 font-light text-sm">Rellena el formulario para crear tu cuenta nueva.</p>
                </div>

                <form class="flex flex-col gap-6" onsubmit="return false;">
                    <!-- Email -->
                    <div class="relative">
                        <input type="email" id="email" placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-2 text-base transition-colors duration-300 peer font-serif" />
                        <label for="email" class="absolute left-0 top-2 text-gray-400 transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-6 peer-focus:text-primary peer-focus:text-xs peer-not-placeholder-shown:-translate-y-6 peer-not-placeholder-shown:text-xs">Correo Electrónico</label>
                    </div>
                    <!-- Usuario -->
                    <div class="relative mt-2">
                        <input type="text" id="username" placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-2 text-base transition-colors duration-300 peer font-serif" />
                        <label for="username" class="absolute left-0 top-2 text-gray-400 transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-6 peer-focus:text-primary peer-focus:text-xs peer-not-placeholder-shown:-translate-y-6 peer-not-placeholder-shown:text-xs">Usuario</label>
                    </div>
                    <!-- Contraseñas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-2">
                        <div class="relative">
                            <input type="password" id="password" placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-2 text-base transition-colors duration-300 peer font-serif" />
                            <label for="password" class="absolute left-0 top-2 text-gray-400 transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-6 peer-focus:text-primary peer-focus:text-xs peer-not-placeholder-shown:-translate-y-6 peer-not-placeholder-shown:text-xs">Contraseña</label>
                        </div>
                        <div class="relative">
                            <input type="password" id="confirm_password" placeholder=" " class="w-full bg-transparent border-b-2 border-gray-200 focus:border-primary text-dark outline-none py-2 text-base transition-colors duration-300 peer font-serif" />
                            <label for="confirm_password" class="absolute left-0 top-2 text-gray-400 transition-all duration-300 pointer-events-none uppercase tracking-widest text-xs font-bold peer-focus:-translate-y-6 peer-focus:text-primary peer-focus:text-xs peer-not-placeholder-shown:-translate-y-6 peer-not-placeholder-shown:text-xs">Confirmar</label>
                        </div>
                    </div>
                    <!-- Política de privacidad -->
                    <div class="flex items-center gap-3 mt-4">
                        <label class="relative flex items-center cursor-pointer">
                            <input type="checkbox" class="peer sr-only" id="terms">
                            <div class="w-4 h-4 border-2 border-primary rounded-sm transition-colors peer-checked:bg-primary"></div>
                            <svg class="absolute w-3 h-3 text-white hidden peer-checked:block left-0.5 top-0.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 13l4 4L19 7"/></svg>
                        </label>
                        <div class="text-[10px] text-gray-600 font-medium tracking-widest uppercase">
                            <label for="terms" class="cursor-pointer">Acepto la</label>
                            <button type="button" id="btn-privacy" class="text-primary hover:text-dark font-bold underline transition-colors cursor-pointer outline-none ml-0.5">política de privacidad</button>
                        </div>
                    </div>
                    <div class="flex justify-end mt-2">
                        <a href="Login.html" class="text-[10px] text-primary hover:text-dark transition-colors tracking-widest uppercase font-bold underline underline-offset-4">¿Ya tienes cuenta?</a>
                    </div>
                    <div class="mt-4">
                        <button type="button" id="btn-registro" class="w-full bg-dark text-white px-8 py-4 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 shadow-xl hover:bg-primary hover:-translate-y-1 transform">
                            Crear Cuenta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Modal Privacidad -->
    <div id="modal-privacy" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-dark/70 backdrop-blur-sm"></div>
        <div class="relative w-full max-w-lg bg-white rounded-[30px] p-8 md:p-12 shadow-2xl z-10 m-4 fade-in-up" style="animation-duration:0.4s;">
            <button type="button" id="btn-close-modal" class="absolute top-6 right-6 p-2 text-gray-400 hover:text-dark transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <h3 class="font-serif text-2xl font-bold text-dark mb-6">Política de Privacidad</h3>
            <div class="text-sm font-light text-gray-600 space-y-4 max-h-[50vh] overflow-y-auto pr-4">
                <p><strong class="font-bold text-dark">Condiciones Generales</strong></p>
                <p>Al registrarse, usted acepta que el Restaurante Elegance almacene sus datos personales (nombre, correo electrónico) con la finalidad de gestionar sus reservas y mejorar su experiencia gastronómica.</p>
                <p>Nos comprometemos a proteger su privacidad. Sus datos no serán compartidos con terceros sin su consentimiento explícito, salvo obligación legal.</p>
                <p>Puede ejercer sus derechos de acceso, rectificación, cancelación u oposición contactando a nuestro correo de reservas.</p>
            </div>
            <div class="mt-8 pt-6 border-t border-gray-100 flex justify-center">
                <button type="button" id="btn-aceptar-modal" class="bg-primary text-white px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-dark transition-colors shadow-md">
                    Aceptar y Cerrar
                </button>
            </div>
        </div>
    </div>

@section Scripts {
    <script type="module" src="~/js/controllers/AuthController.js"></script>
}
