            showCancelButton: true,
            confirmButtonText: 'Sí, restaurar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
        return false;
    }

    function confirmarBorradoDefinitivo(event) {
        event.preventDefault();
        const form = event.target;

        Swal.fire({
            ...swalConfig,
            title: '¡ADVERTENCIA!',
            text: "Esta acción eliminará permanentemente los datos y no se podrán recuperar. ¿Estás completamente seguro?",
            icon: 'warning',
