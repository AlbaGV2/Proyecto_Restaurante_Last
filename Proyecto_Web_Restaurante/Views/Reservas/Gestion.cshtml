    function toggleUsuarios() {
        const usuarios = document.getElementById('seccion-usuarios');
        usuarios.classList.toggle('hidden');
        
        // Ocultar otras secciones si se abre usuarios
        if (!usuarios.classList.contains('hidden')) {
            document.getElementById('seccion-papelera').classList.add('hidden');
