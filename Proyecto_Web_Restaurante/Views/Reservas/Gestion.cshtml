    function toggleHistorialDescargas() {
        const historial = document.getElementById('seccion-historial');
        historial.classList.toggle('hidden');
        
        // Ocultar papelera si se abre historial
        if (!historial.classList.contains('hidden')) {
            document.getElementById('seccion-papelera').classList.add('hidden');
