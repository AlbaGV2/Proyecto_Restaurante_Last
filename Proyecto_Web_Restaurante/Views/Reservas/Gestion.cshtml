    async function registrarDescargaEnServidor(formato, total, fInicio, fFin) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        try {
            const respuesta = await fetch('/Reservas/RegistrarDescarga', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    Formato: formato,
                    TotalRegistros: total,
                    FiltroFechaInicio: fInicio ? convertirADate(fInicio) : null,
                    FiltroFechaFin: fFin ? convertirADate(fFin) : null
                })
            });
            const data = await respuesta.json();
            if (respuesta.ok && data.success) {
                // Agregar fila dinámicamente al historial de descargas
                agregarFilaHistorial({
                    idFormateado: data.idFormateado,
                    usuarioNombre: data.usuarioNombre,
                    formato: formato,
                    total: total,
                    fInicio: fInicio,
                    fFin: fFin
                });
            }
        } catch (err) { console.error('Error al registrar log:', err); }
    }

    function agregarFilaHistorial(info) {
        const tbody = document.querySelector('#seccion-historial tbody');
        if (!tbody) return;

        // Si existe la fila de "No hay registros", removerla
        const filaVacia = tbody.querySelector('td[colspan="7"]');
        if (filaVacia) {
            filaVacia.parentElement.remove();
        }

        // Formatear fecha descarga a "dd/MM/yyyy HH:mm"
        const ahora = new Date();
        const dia = String(ahora.getDate()).padStart(2, '0');
        const mes = String(ahora.getMonth() + 1).padStart(2, '0');
        const año = ahora.getFullYear();
        const horas = String(ahora.getHours()).padStart(2, '0');
        const minutos = String(ahora.getMinutes()).padStart(2, '0');
        const fechaDescargaStr = `${dia}/${mes}/${año} ${horas}:${minutos}`;

        // Color badge del formato
        let formatoColorClass = 'bg-blue-100 text-blue-600';
        if (info.formato === 'pdf') {
            formatoColorClass = 'bg-red-100 text-red-600';
        } else if (info.formato === 'excel') {
            formatoColorClass = 'bg-green-100 text-green-600';
        }

        // Filtro string
        let filtroStr = 'Sin filtros';
        if (info.fInicio || info.fFin) {
            const formatFiltro = (f) => {
                if (!f) return '...';
                const parts = f.split('/');
                if (parts.length === 3) return `${parts[0]}/${parts[1]}`;
                return f;
            };
            filtroStr = `${formatFiltro(info.fInicio)} - ${formatFiltro(info.fFin)}`;
        }

        // Crear la nueva fila
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-secondary/20 transition-colors';
        tr.innerHTML = `
            <td class="px-8 py-4 font-bold text-primary">${info.idFormateado}</td>
            <td class="px-8 py-4 text-gray-500">${fechaDescargaStr}</td>
            <td class="px-8 py-4 font-semibold text-dark">${info.usuarioNombre}</td>
            <td class="px-8 py-4">
                <span class="px-2 py-1 rounded-md text-[9px] font-black uppercase ${formatoColorClass}">
                    ${info.formato}
                </span>
            </td>
            <td class="px-8 py-4 font-bold">${info.total}</td>
            <td class="px-8 py-4 text-[10px] text-gray-400">${filtroStr}</td>
            <td class="px-8 py-4 text-center">
                <span class="flex items-center justify-center gap-1.5 text-green-600 font-bold text-[9px] uppercase tracking-tighter">
                    <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
                    Completado
                </span>
            </td>
        `;

        // Insertar al inicio de la tabla (prepend)
        tbody.insertBefore(tr, tbody.firstChild);
    }

    function convertirADate(str) {
        if (!str) return null;
        const [d, m, y] = str.split('/');
        return `${y}-${m}-${d}`;
    }

    async function exportarFormato(tipo) {
        const menu = document.getElementById('menuExportar');
        let fechaInicio = document.getElementById('export_inicio').value;
        let fechaFin = document.getElementById('export_fin').value;
        
        // Función de validación de fecha real
        const esFechaValida = (f) => {
            if (!f) return true;
            const regex = /^(\d{2})\/(\d{2})\/(\d{4})$/;
            if (!regex.test(f)) return false;
            
            const [_, d, m, y] = f.match(regex);
            const dia = parseInt(d);
            const mes = parseInt(m);
            const anio = parseInt(y);
            
            const date = new Date(anio, mes - 1, dia);
            return date.getFullYear() == anio && date.getMonth() == mes - 1 && date.getDate() == dia;
        };

        // Validar formato y existencia
        if (!esFechaValida(fechaInicio) || !esFechaValida(fechaFin)) {
            Swal.fire({
                ...swalConfig,
                title: 'Fecha Inválida',
                text: 'Por favor, introduce una fecha real en formato DD/MM/AAAA (ej: 30/05/2026).',
                icon: 'error'
            });
            return;
        }

        // Validar rango lógico
        const parsearFecha = (f) => {
            if(!f) return null;
            const [d, m, y] = f.split('/');
            return new Date(y, m - 1, d);
        };

        const dInicio = parsearFecha(fechaInicio);
        const dFin = parsearFecha(fechaFin);

        if (dInicio && dFin && dInicio > dFin) {
            Swal.fire({
                ...swalConfig,
                title: 'Rango Incorrecto',
                text: 'La fecha de inicio no puede ser posterior a la fecha de fin.',
                icon: 'warning'
            });
            return;
        }

        // Convertir formato DD/MM/AAAA a AAAA-MM-DD para el servidor
        const convertirFecha = (f) => {
            if(!f) return "";
            const parts = f.split('/');
            if(parts.length === 3) return `${parts[2]}-${parts[1]}-${parts[0]}`;
            return f;
        };

        const fInicioISO = convertirFecha(fechaInicio);
        const fFinISO = convertirFecha(fechaFin);

        menu.classList.add('hidden');
        
        let datosAExportar = null;

        if (fInicioISO || fFinISO) {
            try {
                document.body.style.cursor = 'wait';
                const response = await fetch(`@Url.Action("GetReservasJSON", "Reservas")?inicio=${fInicioISO}&fin=${fFinISO}`);
                if (!response.ok) throw new Error("Error al obtener datos");
                datosAExportar = await response.json();
            } catch (error) {
                Swal.fire({
                    ...swalConfig,
                    title: 'Error',
                    text: 'Hubo un problema al conectar con el servidor.',
                    icon: 'error'
                });
                console.error(error);
            } finally {
                document.body.style.cursor = 'default';
            }
        }

        if ((fechaInicio || fechaFin) && (!datosAExportar || datosAExportar.length === 0)) {
            Swal.fire({
                ...swalConfig,
                title: 'Sin Resultados',
                text: 'No se encontraron reservas en el periodo seleccionado.',
                icon: 'info'
            });
            return;
        }

        switch(tipo) {
            case 'pdf':
                await generarPDF(datosAExportar);
                break;
            case 'excel':
                await generarExcel(datosAExportar);
                break;
            case 'csv':
                generarCSV(datosAExportar);
                break;
            case 'svg':
                generarSVG(datosAExportar);
                break;
        }
    }

    function cargarScript(url) {
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = url;
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
        });
    }

    async function generarPDF(datosExtra = null) {
        if (typeof jspdf === 'undefined') {
            await cargarScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');
            await cargarScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js');
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('l', 'mm', 'a4');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(20);
        doc.setTextColor(26, 26, 26);
        doc.text("REPORTE DE RESERVAS", 14, 20);
        
        doc.setFontSize(10);
        doc.setTextColor(197, 168, 128);
        const subtitulo = datosExtra ? "Filtro personalizado aplicado" : "Vista actual de la gestión";
        doc.text(`${subtitulo} | Generado: ${new Date().toLocaleString()}`, 14, 28);

        const config = {
            startY: 35,
            theme: 'striped',
            headStyles: { fillColor: [26, 26, 26], textColor: [255, 255, 255], fontSize: 9, halign: 'center' },
            bodyStyles: { fontSize: 8, textColor: [50, 50, 50] },
            alternateRowStyles: { fillColor: [249, 246, 240] },
            margin: { left: 14, right: 14 }
        };

        if (datosExtra) {
            // Generar desde los datos JSON recibidos del servidor
            // IMPORTANTE: Los nombres de los campos deben coincidir con el JSON (camelCase por defecto en .NET)
            doc.autoTable({
                ...config,
                head: [['ID', 'Fecha', 'Hora', 'Cliente', 'Email', 'Teléfono', 'Pers.', 'Turno']],
                body: datosExtra.map(r => [
                    r.idReserva || r.IdReserva, 
                    r.fecha || r.Fecha, 
                    r.hora || r.Hora, 
                    r.nombre || r.Nombre, 
                    r.email || r.Email, 
                    r.telefono || r.Telefono,
                    r.personas || r.Personas, 
                    r.turno || r.Turno
                ])
            });
        } else {
            // Generar desde la tabla HTML actual
            doc.autoTable({
                ...config,
                html: '#tablaReservas',
                columns: [
                    { header: 'ID', dataKey: 0 },
                    { header: 'Fecha', dataKey: 1 },
                    { header: 'Hora', dataKey: 2 },
                    { header: 'Cliente', dataKey: 3 },
                    { header: 'Email', dataKey: 4 },
                    { header: 'Teléfono', dataKey: 5 },
                    { header: 'Pers.', dataKey: 6 },
                    { header: 'Turno', dataKey: 7 }
                ],
                didParseCell: function(data) {
                    if (data.section === 'body') {
                        if (data.cell.text && data.cell.text.length > 0) {
                            data.cell.text = [data.cell.text[0].split('\n')[0].trim()];
                        }
                    }
                }
            });
        }

        doc.save(`Reservas_${new Date().toISOString().slice(0,10)}.pdf`);

        // Registrar en historial
        const numFilas = datosExtra ? datosExtra.length : document.querySelectorAll('#tablaReservas tbody tr:not(.hidden)').length;
        registrarDescargaEnServidor('pdf', numFilas, document.getElementById('export_inicio').value, document.getElementById('export_fin').value);
    }

    async function generarExcel(datosExtra = null) {
        if (typeof XLSX === 'undefined') {
            await cargarScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
        }

        let ws;
        if (datosExtra) {
            ws = XLSX.utils.json_to_sheet(datosExtra);
        } else {
            const table = document.getElementById('tablaReservas');
            const clone = table.cloneNode(true);
            clone.querySelectorAll('tr').forEach(tr => {
                if (tr.lastElementChild) tr.removeChild(tr.lastElementChild);
            });
            ws = XLSX.utils.table_to_sheet(clone);
        }

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Reservas");
        XLSX.writeFile(wb, `Reservas_${new Date().toISOString().slice(0,10)}.xlsx`);

        // Registrar en historial
        const numFilas = datosExtra ? datosExtra.length : document.querySelectorAll('#tablaReservas tbody tr:not(.hidden)').length;
        registrarDescargaEnServidor('excel', numFilas, document.getElementById('export_inicio').value, document.getElementById('export_fin').value);
    }

    function generarCSV(datosExtra = null) {
        let csv = [];
        
        if (datosExtra) {
            const headers = Object.keys(datosExtra[0]);
            csv.push(headers.join(","));
            datosExtra.forEach(r => {
                csv.push(headers.map(h => `"${r[h]}"`).join(","));
            });
        } else {
            const table = document.getElementById('tablaReservas');
            const rows = table.querySelectorAll("tr");
            for (let i = 0; i < rows.length; i++) {
                const row = [], cols = rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length - 1; j++) {
                    let text = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                    row.push('"' + text + '"');
                }
                csv.push(row.join(","));
            }
        }

        const blob = new Blob(["\ufeff" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", `Reservas_${new Date().toISOString().slice(0,10)}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();

        // Registrar en historial
        const numFilas = datosExtra ? datosExtra.length : document.querySelectorAll('#tablaReservas tbody tr:not(.hidden)').length;
        registrarDescargaEnServidor('csv', numFilas, document.getElementById('export_inicio').value, document.getElementById('export_fin').value);
    
        document.body.removeChild(link);
    }

    function generarSVG(datosExtra = null) {
        // Crear un SVG simple con los datos en formato texto vectorial
        const filas = datosExtra || Array.from(document.querySelectorAll('#tablaReservas tbody tr:not(.hidden)')).map(tr => Array.from(tr.cells).slice(0, -1).map(c => c.innerText.trim()));
        
        let svgContent = `<svg xmlns="http://www.w3.org/2000/svg" width="800" height="${filas.length * 25 + 100}">
            <rect width="100%" height="100%" fill="#ffffff"/>
            <text x="20" y="40" font-family="Serif" font-size="24" font-weight="bold" fill="#1A1A1A">REPORTE DE RESERVAS - VECTORIAL</text>
            <text x="20" y="70" font-family="sans-serif" font-size="12" fill="#C5A880">Generado: ${new Date().toLocaleString()}</text>`;
        
        let y = 110;
        filas.forEach((fila, i) => {
            const texto = Array.isArray(fila) ? fila.join(" | ") : `${fila.idReserva || fila.IdReserva} | ${fila.nombre || fila.Nombre} | ${fila.telefono || fila.Telefono} | ${fila.fecha || fila.Fecha}`;
            svgContent += `<text x="20" y="${y}" font-family="monospace" font-size="10" fill="#333333">${texto}</text>`;
            y += 25;
        });
        
        svgContent += `</svg>`;

        const blob = new Blob([svgContent], {type: 'image/svg+xml;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `Reservas_${new Date().toISOString().slice(0,10)}.svg`;
        link.click();

        // Registrar en historial
        registrarDescargaEnServidor('svg', filas.length, document.getElementById('export_inicio').value, document.getElementById('export_fin').value);
    }

    // --- LÓGICA DE MÁSCARA DE FECHA (ESCRITURA MANUAL) ---
    document.addEventListener('DOMContentLoaded', () => {
        // Alerta de login exitoso si proviene de AuthController.js
        const mostrarLoginExito = sessionStorage.getItem('mostrar_login_exito');
        if (mostrarLoginExito === 'true') {
            const ultimoAccesoMsg = sessionStorage.getItem('login_ultimo_acceso') || 'Primer acceso registrado.';
            sessionStorage.removeItem('mostrar_login_exito');
            sessionStorage.removeItem('login_ultimo_acceso');
            
            Swal.fire({
                toast: true,
                position: 'top-end',
                showCloseButton: true,
                showConfirmButton: false,
                timer: 60000, // Máximo 1 minuto
                timerProgressBar: true,
                icon: 'success',
                title: 'Sesión iniciada correctamente',
                html: `<div style="font-size: 11px; color: #6b7280; font-weight: 300; margin-top: 4px; text-align: left;">${ultimoAccesoMsg}</div>`,
                customClass: {
                    popup: 'rounded-2xl border border-primary/20 shadow-xl font-sans',
                    title: 'text-sm font-bold text-dark text-left'
                }
            });
        }

        const dateInputs = document.querySelectorAll('.date-mask');
        
        dateInputs.forEach(input => {
            input.addEventListener('input', (e) => {
                let v = e.target.value.replace(/\D/g, '').slice(0, 8);
                if (v.length >= 5) {
                    v = v.slice(0, 2) + '/' + v.slice(2, 4) + '/' + v.slice(4);
                } else if (v.length >= 3) {
                    v = v.slice(0, 2) + '/' + v.slice(2);
                }
                e.target.value = v;
            });

            // Validación simple al perder el foco
            input.addEventListener('blur', (e) => {
                const val = e.target.value;
                if (val && val.length < 10) {
                    // Si la fecha está incompleta, avisar o limpiar (opcional)
                    // console.log("Fecha incompleta");
                }
            });
        });
    });

    // Sincronizar el input invisible de calendario con el campo de texto manual
    function sincronizarFecha(picker, textInputId) {
        if (!picker.value) return;
        const [year, month, day] = picker.value.split('-');
        const formatted = `${day}/${month}/${year}`;
        document.getElementById(textInputId).value = formatted;
        
        // Trigger input event to ensure mask and other logic updates
        document.getElementById(textInputId).dispatchEvent(new Event('input'));
    }
</script>
