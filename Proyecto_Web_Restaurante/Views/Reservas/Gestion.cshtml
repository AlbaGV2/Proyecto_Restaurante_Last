</div>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Configuración base de SweetAlert2 para el restaurante
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true
    });

    const swalConfig = {
        confirmButtonColor: '#1A1A1A',
        cancelButtonColor: '#f3f4f6',
        customClass: {
            popup: 'rounded-[30px] border-none shadow-2xl',
            confirmButton: 'rounded-xl px-8 py-3 text-[10px] font-bold uppercase tracking-widest',
            cancelButton: 'rounded-xl px-8 py-3 text-[10px] font-bold uppercase tracking-widest text-gray-500'
        }
    };

    // Datos del calendario desde el servidor
    const conteosPorFecha = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ConteosPorFecha.ToDictionary(k => k.Key.ToString("yyyy-MM-dd"), v => v.Value)));
    
    let currentDate = new Date();

    function abrirCalendario() {
        document.getElementById('modalCalendario').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        renderCalendar();
    }

    function cerrarCalendario() {
        document.getElementById('modalCalendario').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    function cambiarMes(delta) {
        currentDate.setMonth(currentDate.getMonth() + delta);
        renderCalendar();
    }

    function irAHoy() {
        currentDate = new Date();
        renderCalendar();
    }

    function saltarAFfecha(val) {
        if (!val) return;
        const [year, month] = val.split('-');
        currentDate = new Date(year, month - 1, 1);
        renderCalendar();
    }

    function renderCalendar() {
        const grid = document.getElementById('calendar-grid');
        const monthYear = document.getElementById('cal-month-year');
        grid.innerHTML = '';

        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();

        // Localización del mes
        const nombresMeses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
        monthYear.innerText = `${nombresMeses[month]} ${year}`;

        // Primer día del mes
        const firstDay = new Date(year, month, 1);
        // Ajuste para que lunes sea el primer día (0: Dom -> 6, 1: Lun -> 0)
        let startDay = firstDay.getDay() - 1;
        if (startDay === -1) startDay = 6;

        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const today = new Date();
        today.setHours(0,0,0,0);

        // Espacios vacíos para el inicio
        for (let i = 0; i < startDay; i++) {
            grid.innerHTML += `<div class="h-16"></div>`;
        }

        // Días del mes
        for (let day = 1; day <= daysInMonth; day++) {
            const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
            const dateObj = new Date(year, month, day);
            const isClosed = dateObj.getDay() === 1; // 1 = Lunes
            const count = conteosPorFecha[dateStr] || 0;
            const isToday = today.getTime() === dateObj.getTime();
            
            const dayElement = document.createElement('div');
            
            let bgClass = 'bg-gray-50/50 hover:bg-gray-100';
            let textClass = 'text-dark/40';
            let borderClass = 'border-transparent';

            if (isClosed) {
                bgClass = 'bg-red-50/40 hover:bg-red-50';
                textClass = 'text-red-300';
                borderClass = 'border-red-100/50';
            } else if (count > 0) {
                bgClass = 'bg-primary/5 hover:bg-primary/10';
                textClass = 'text-primary';
                borderClass = 'border-primary/10';
            }
            
            dayElement.className = `group relative h-16 rounded-2xl transition-all cursor-pointer flex flex-col items-center justify-center border
                ${bgClass} ${borderClass}
                ${isToday ? 'ring-2 ring-primary ring-offset-2' : ''}`;
            
            if (!isClosed) {
                dayElement.onclick = () => filtrarPorDia(dateStr);
            } else {
                dayElement.style.cursor = 'not-allowed';
                dayElement.title = 'Restaurante Cerrado';
            }

            dayElement.innerHTML = `
                <span class="text-sm font-bold ${textClass}">${day}</span>
                ${isClosed ? '<span class="text-[7px] uppercase font-black text-red-300/60 mt-0.5 tracking-tighter">Cerrado</span>' : ''}
                ${count > 0 ? `
                    <div class="absolute -top-1.5 -right-1.5 bg-primary text-white text-[8px] font-black w-5 h-5 flex items-center justify-center rounded-full shadow-lg shadow-primary/30 transform group-hover:scale-110 transition-transform">
                        ${count}
                    </div>
                ` : ''}
            `;
            
            grid.appendChild(dayElement);
        }
    }

    function filtrarPorDia(fecha) {
        // Redirigir a la gestión filtrando por este día específico
        const url = `@Url.Action("Gestion", "Reservas")?fechaInicio=${fecha}&fechaFin=${fecha}`;
        window.location.href = url;
    }

    function abrirModalFiltro() {
        document.getElementById('modalFiltro').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function cerrarModalFiltro() {
        document.getElementById('modalFiltro').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    function limpiarFiltro() {
        // Redirigir a la gestión sin parámetros de fecha
        window.location.href = '@Url.Action("Gestion", "Reservas", new { sortOrder = Model.SortOrder })';
    }

    function splitTelefono(telefonoFull) {
        if (!telefonoFull) return { prefijo: '+34', numero: '' };
        telefonoFull = telefonoFull.trim();
        const prefijos = ['+351', '+34', '+33', '+39', '+44', '+49', '+52', '+57', '+54', '+56', '+55', '+1'];
        for (const p of prefijos) {
            if (telefonoFull.startsWith(p)) {
                return {
                    prefijo: p,
                    numero: telefonoFull.substring(p.length).trim()
                };
            }
        }
        return { prefijo: '+34', numero: telefonoFull };
    }

    function abrirModalEditar(datos) {
        document.getElementById('edit_id').value = datos.id;
        document.getElementById('edit_idReserva').value = datos.idReserva;
        document.getElementById('modalIdReserva').innerText = datos.idReserva;
        document.getElementById('edit_nombre').value = datos.nombre;
        document.getElementById('edit_email').value = datos.email;
        
        const telParsed = splitTelefono(datos.telefono);
        document.getElementById('edit_prefijo').value = telParsed.prefijo;
        document.getElementById('edit_telefono_num').value = telParsed.numero;
        document.getElementById('edit_telefono').value = datos.telefono;
        
        document.getElementById('edit_fecha').value = datos.fecha;
        document.getElementById('edit_personas').value = datos.personas;
        document.getElementById('edit_turno').value = datos.turno;
        document.getElementById('edit_hora').value = datos.hora;

        document.getElementById('modalEditar').classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Bloquear scroll
    }

    function cerrarModal() {
        document.getElementById('modalEditar').classList.add('hidden');
        document.body.style.overflow = 'auto'; // Restaurar scroll
    }

    function confirmarEdicion(event) {
        event.preventDefault();
        const form = event.target;
        
        const prefijo = document.getElementById('edit_prefijo').value;
        const numero = document.getElementById('edit_telefono_num').value.trim();
        document.getElementById('edit_telefono').value = prefijo + ' ' + numero;
        
        Swal.fire({
            ...swalConfig,
            title: '¿Guardar cambios?',
            text: "Se actualizará la información de la reserva.",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, guardar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
        return false;
    }

    function toggleLeyenda() {
        const leyenda = document.getElementById('leyendaModificacion');
        leyenda.classList.toggle('hidden');
        
        // Cerrar al hacer click fuera
        if (!leyenda.classList.contains('hidden')) {
            const closeHandler = (e) => {
                if (!leyenda.contains(e.target) && !e.target.closest('button')) {
                    leyenda.classList.add('hidden');
                    document.removeEventListener('click', closeHandler);
                }
            };
            setTimeout(() => document.addEventListener('click', closeHandler), 10);
        }
    }

    function togglePapelera() {
        const papelera = document.getElementById('seccion-papelera');
        papelera.classList.toggle('hidden');
        
        if (!papelera.classList.contains('hidden')) {
            document.getElementById('seccion-historial').classList.add('hidden');
            document.getElementById('seccion-usuarios').classList.add('hidden');
        }
