@model Restaurante.Models.Reserva
@{
    ViewData["Title"] = "Editar Reserva";
}

<!-- Hero -->
<div class="w-full h-[40vh] relative animate-on-scroll">
    <img src="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Editar" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4">
        <h1 class="font-serif text-3xl md:text-4xl text-white font-bold tracking-wider mb-6">Editar Reserva</h1>
        <div class="w-16 h-0.5 bg-primary mx-auto mb-6"></div>
        <p class="text-white/80 font-light tracking-widest uppercase text-sm">Modificar datos de la reserva @Model.IdReserva</p>
    </div>
</div>

<div class="px-4 md:px-10 py-24 bg-secondary/30 min-h-[60vh]">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-[30px] p-8 md:p-12 shadow-sm border border-[#eaddce]/50">
            <form asp-action="Editar" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IdReserva" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nombre -->
                    <div class="space-y-2">
                        <label asp-for="Nombre" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Nombre Completo</label>
                        <input asp-for="Nombre" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium" />
                        <span asp-validation-for="Nombre" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>

                    <!-- Email -->
                    <div class="space-y-2">
                        <label asp-for="Email" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Email</label>
                        <input asp-for="Email" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium" />
                        <span asp-validation-for="Email" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>

                    <!-- Fecha -->
                    <div class="space-y-2">
                        <label asp-for="Fecha" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Fecha</label>
                        <input asp-for="Fecha" type="date" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium" />
                        <span asp-validation-for="Fecha" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>

                    <!-- Personas -->
                    <div class="space-y-2">
                        <label asp-for="Personas" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Nº Personas</label>
                        <input asp-for="Personas" type="number" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium" />
                        <span asp-validation-for="Personas" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>

                    <!-- Turno -->
                    <div class="space-y-2">
                        <label asp-for="Turno" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Turno</label>
                        <select asp-for="Turno" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium">
                            <option value="Comida">Comida</option>
                            <option value="Cena">Cena</option>
                        </select>
                        <span asp-validation-for="Turno" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>

                    <!-- Hora -->
                    <div class="space-y-2">
                        <label asp-for="Hora" class="text-[10px] uppercase tracking-[0.2em] font-bold text-dark/60 ml-1">Hora</label>
                        <input asp-for="Hora" class="w-full bg-secondary/20 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-primary/20 transition-all text-dark font-medium" />
                        <span asp-validation-for="Hora" class="text-red-500 text-[10px] uppercase font-bold tracking-wider"></span>
                    </div>
                </div>

                <div class="flex gap-4 pt-6">
                    <button type="submit" class="flex-1 bg-dark text-white py-5 rounded-2xl text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-primary transition-all shadow-xl shadow-dark/10">
                        Guardar Cambios
                    </button>
                    <a asp-action="Gestion" class="px-8 bg-secondary/40 text-dark py-5 rounded-2xl text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-secondary/60 transition-all text-center flex items-center">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
