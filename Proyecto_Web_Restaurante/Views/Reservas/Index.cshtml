@{
    ViewData["Title"] = "Reservas";
}

<!-- Hero -->
        <div class="w-full h-[50vh] md:h-[65vh] relative animate-on-scroll">
            <img src="https://images.unsplash.com/photo-1544148103-0773bf10d330?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Mesa preparada" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/50"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4 animate-on-scroll" data-delay="0.2s">
                <h1 class="font-serif text-3xl md:text-4xl text-white font-bold tracking-wider mb-6">Reservas</h1>
                <div class="w-16 h-0.5 bg-primary mx-auto mb-6"></div>
                <p class="text-white/80 font-light tracking-widest uppercase text-sm">Asegure su mesa</p>
                <div class="mt-8 flex gap-4">
                    <a asp-action="Gestion" class="bg-white/10 hover:bg-white/20 text-white border border-white/30 px-6 py-2 rounded-full text-[10px] font-bold tracking-[0.2em] uppercase transition-all backdrop-blur-sm">
                        Gestor Reservas
                    </a>
                </div>
            </div>
        </div>

        <!-- Formulario Reserva -->
        <div class="px-4 md:px-10 py-24 flex justify-center bg-white animate-on-scroll">
            <div class="bg-secondary rounded-[40px] px-4 md:px-16 py-16 md:py-24 max-w-4xl w-full shadow-sm border border-[#eaddce]/50 relative">

                @Html.AntiForgeryToken()

                <div class="text-center mb-16 animate-on-scroll" data-delay="0.1s">
                    <h2 class="font-serif text-2xl md:text-3xl font-bold text-dark mb-4">Detalles de la Reserva</h2>
                    <p class="text-gray-500 font-light text-sm">Seleccione el número de comensales, la fecha y la hora deseada.</p>
                </div>

                <!-- Personas | Fecha -->
                <div class="flex flex-col md:flex-row justify-between items-center border-b border-[#eaddce] pb-10 mb-12 px-2 md:px-8 text-dark animate-on-scroll" data-delay="0.2s">
                    <div class="flex flex-col items-center md:items-start gap-1 mb-8 md:mb-0 w-full md:w-1/3">
                        <label for="personas" class="text-[11px] tracking-widest uppercase font-bold text-gray-500 mb-2">Comensales</label>
                        <select id="personas" class="bg-transparent text-lg font-serif text-dark outline-none cursor-pointer text-center md:text-left border-b border-gray-300 focus:border-primary pb-2 w-full max-w-[160px] transition-colors appearance-none">
                            <option value="1">1 Persona</option>
                            <option value="2" selected>2 Personas</option>
                            <option value="3">3 Personas</option>
                            <option value="4">4 Personas</option>
                            <option value="5">5 Personas</option>
                            <option value="6">6 Personas</option>
                            <option value="7">7 Personas</option>
                            <option value="8">8+ Personas</option>
                        </select>
                    </div>
                    <div class="hidden md:block w-px h-16 bg-[#eaddce]"></div>
                    <div class="flex flex-col items-center md:items-end gap-1 w-full md:w-1/3">
                        <label for="fecha" class="text-[11px] tracking-widest uppercase font-bold text-gray-500 mb-2">Día de Reserva</label>
                        <input type="date" id="fecha" class="bg-transparent text-lg font-serif text-dark outline-none cursor-pointer text-center md:text-right border-b border-gray-300 focus:border-primary pb-2 w-full max-w-[200px] transition-colors" />
                    </div>
                </div>

                <!-- Selector Turno -->
                <div class="flex justify-center mb-12 animate-on-scroll" data-delay="0.3s">
                    <div class="bg-white p-1.5 rounded-full shadow-sm flex gap-1 border border-gray-100">
                        <button type="button" id="btn-comida" class="px-8 py-3 rounded-full text-xs tracking-[0.15em] font-bold bg-dark text-white transition-colors w-32 uppercase">Comida</button>
                        <button type="button" id="btn-cena" class="px-8 py-3 rounded-full text-xs tracking-[0.15em] font-bold text-gray-500 hover:text-dark transition-colors w-32 uppercase">Cena</button>
                    </div>
                </div>

                <!-- Grids de horas — renderizados por ReservasController.js -->
                <div class="animate-on-scroll" data-delay="0.4s" id="hours-container">
                    <div id="grid-comidas" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-x-6 md:gap-y-6 mb-16 px-2 md:px-8"></div>
                    <div id="grid-cenas"   class="hidden grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-x-6 md:gap-y-6 mb-16 px-2 md:px-8"></div>
                </div>

                <!-- Datos del Cliente: Nombre y Email -->
                <div class="flex flex-col md:flex-row justify-between items-start border-b border-[#eaddce] pb-10 mb-12 px-2 md:px-8 gap-8 animate-on-scroll" data-delay="0.5s">
                    <div class="flex flex-col gap-1 w-full md:w-1/2">
                        <label for="nombre" class="text-[11px] tracking-widest uppercase font-bold text-gray-500 mb-2">Nombre</label>
                        <input type="text" id="nombre" maxlength="30" placeholder="Su nombre completo"
                               class="bg-transparent text-lg font-serif text-dark outline-none border-b border-gray-300 focus:border-primary pb-2 w-full transition-colors" />
                        <span id="error-nombre" class="text-red-500 text-xs mt-1 hidden"></span>
                    </div>
                    <div class="flex flex-col gap-1 w-full md:w-1/2">
                        <label for="email" class="text-[11px] tracking-widest uppercase font-bold text-gray-500 mb-2">Email</label>
                        <input type="email" id="email" maxlength="50" placeholder="su@email.com"
                               class="bg-transparent text-lg font-serif text-dark outline-none border-b border-gray-300 focus:border-primary pb-2 w-full transition-colors" />
                        <span id="error-email" class="text-red-500 text-xs mt-1 hidden"></span>
                    </div>
                </div>

                <!-- Mensaje de respuesta del servidor -->
                <div id="mensaje-reserva" class="hidden text-center mb-8 px-4 py-3 rounded-2xl text-sm font-medium"></div>

                <!-- Botón Reservar -->
                <div class="flex justify-center animate-on-scroll" data-delay="0.6s">
                    <button type="button" id="btn-reservar"
                        data-active="false"
                        class="bg-primary text-white px-16 py-4 w-full md:w-auto rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-colors duration-300 shadow-xl opacity-50 cursor-not-allowed pointer-events-none data-[active=true]:opacity-100 data-[active=true]:cursor-pointer data-[active=true]:pointer-events-auto data-[active=true]:hover:bg-dark">
                        Reservar
                    </button>
                </div>
            </div>
        </div>
@section Styles {
    <style>
        input[type="date"]::-webkit-calendar-picker-indicator { cursor: pointer; opacity: 0.6; transition: 0.2s; }
        input[type="date"]::-webkit-calendar-picker-indicator:hover { opacity: 1; }
    </style>
}

@section Scripts {
    <script type="module" src="~/js/controllers/ReservasController.js"></script>
}
